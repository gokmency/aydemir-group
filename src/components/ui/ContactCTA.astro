---
interface Props { title?: string; project?: string }
const { title = 'Proje hakkında bilgi alın.', project } = Astro.props;
const message = project ? `${project} hakkında bilgi almak istiyorum.` : 'Projeler hakkında bilgi almak istiyorum.';
---
<section class="contact-cta">
  <div class="container-wide contact-cta__inner" data-reveal>
    <div><span class="eyebrow">Satış ve proje bilgisi</span><h2>{title}</h2></div>
    <div class="contact-cta__actions">
      <p>Daire tipleri, teslim süreci ve satış seçenekleri için arayın veya WhatsApp’tan yazın.</p>
      <a class="button button--light" href={`https://wa.me/905404175353?text=${encodeURIComponent(message)}`} target="_blank" rel="noopener noreferrer">WhatsApp’tan yazın <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="tel:+905404175353">0 540 417 53 53</a>
    </div>
  </div>
</section>
<style>
  .contact-cta{padding:clamp(85px,11vw,160px) 0;color:#f2eee4;background:var(--dark-soft)}.contact-cta__inner{display:grid;grid-template-columns:1.3fr .7fr;gap:9vw;align-items:end}.contact-cta h2{max-width:12ch;margin:18px 0 0;font:400 clamp(48px,6.7vw,96px)/.96 var(--serif);letter-spacing:-.045em}.contact-cta__actions p{margin:0 0 30px;color:#bdb6aa}.contact-cta__actions .button{margin:0 14px 18px 0}.contact-cta .text-link{margin-top:8px}@media(max-width:800px){.contact-cta__inner{grid-template-columns:1fr;gap:55px}}
</style>
