---
import type { Project } from '../../data/projects';
interface Props { project: Project; index?: number; compact?: boolean }
const { project, index = 0, compact = false } = Astro.props;
const meta = [project.location, project.apartmentTypes?.join(' · ')].filter(Boolean).join(' · ');
---
<article class:list={['project-card', compact && 'project-card--compact']} data-status={project.status} data-reveal>
  <a href={`/projeler/${project.slug}/`} aria-label={`${project.name} projesini incele`}>
    <div class="project-card__media">
      {project.coverImage ? <img src={project.coverImage} alt={`${project.name} mimari görünümü`} width="1200" height="800" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /> : <div class="empty-media">{project.name}</div>}
      <span class="project-card__index">{String(index + 1).padStart(2, '0')}</span>
    </div>
    <div class="project-card__body">
      <div><span class="eyebrow">{project.status} proje</span><h2>{project.name}</h2></div>
      <div class="project-card__meta"><span>{meta || 'Durmuş Aydemir Group'}</span><span aria-hidden="true">↗</span></div>
    </div>
  </a>
</article>
<style>
  .project-card a{display:block}.project-card__media{position:relative;aspect-ratio:1.38;overflow:hidden;background:var(--surface-muted)}.project-card__media img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}.project-card:hover img{transform:scale(1.025)}.project-card__index{position:absolute;top:16px;left:16px;padding:7px 9px;color:#fff;background:rgba(25,24,21,.7);font:10px var(--mono);letter-spacing:.12em}.project-card__body{padding:24px 0 34px;display:grid;grid-template-columns:1fr auto;gap:20px;border-bottom:1px solid var(--border)}.project-card h2{margin:8px 0 0;font:400 clamp(29px,3.2vw,47px)/1 var(--serif);letter-spacing:-.035em}.project-card__meta{display:flex;align-items:end;gap:18px;color:var(--muted);font-size:12px}.project-card__meta span:last-child{color:var(--foreground);font-size:20px}.project-card--compact .project-card__media{aspect-ratio:1.1}.project-card--compact h2{font-size:clamp(26px,2.8vw,38px)}@media(max-width:640px){.project-card__body{grid-template-columns:1fr}.project-card__meta{justify-content:space-between}.project-card__media{aspect-ratio:1.16}}
</style>
