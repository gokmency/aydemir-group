---
import { site } from '../../data/site';
interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const nav = [
  { href: '/projeler/', label: 'Projeler' },
  { href: '/emlak/', label: 'Emlak' },
  { href: '/hizmetler/', label: 'Hizmetler' },
  { href: '/hakkimizda/', label: 'Kurumsal' },
  { href: '/iletisim/', label: 'İletişim' }
];
---
<header class:list={['site-header', transparent && 'site-header--transparent']} data-header>
  <div class="header-inner container-wide">
    <a class="brand" href="/" aria-label={`${site.name} ana sayfa`}>
      <img src="/images/brand/logo.png" width="359" height="105" alt={site.name} />
    </a>
    <nav class="desktop-nav" aria-label="Ana menü">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="/projeler/">Projeleri gör <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span>Menü</span><i aria-hidden="true"></i>
    </button>
  </div>
</header>
  <dialog class="mobile-menu" id="mobile-menu" aria-label="Ana menü">
    <div class="mobile-menu__top container-wide">
      <span class="eyebrow">Durmuş Aydemir Group</span>
      <button class="menu-close" type="button" aria-label="Menüyü kapat" autofocus>Kapat <span aria-hidden="true">×</span></button>
    </div>
    <nav aria-label="Mobil menü">
      <a href="/">Ana Sayfa</a>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="mobile-menu__footer container-wide">
      <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
      <span>Kepez, Antalya</span>
    </div>
  </dialog>
<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const close = document.querySelector('.menu-close');
  const panel = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const desktop = matchMedia('(min-width: 981px)');
  let scrollPosition = 0;
  let locked = false;

  const restorePage = () => {
    if (!locked) return;
    locked = false;
    document.body.classList.remove('menu-open');
    document.documentElement.classList.remove('menu-open');
    document.body.style.removeProperty('--menu-scroll-top');
    toggle?.setAttribute('aria-expanded', 'false');
    if (!desktop.matches) toggle?.focus({ preventScroll: true });
    window.scrollTo({ top: scrollPosition, behavior: 'instant' });
  };
  const closeMenu = () => {
    panel?.close();
    restorePage();
  };
  const openMenu = () => {
    if (!panel || panel.open || desktop.matches) return;
    scrollPosition = window.scrollY;
    locked = true;
    document.body.style.setProperty('--menu-scroll-top', `-${scrollPosition}px`);
    document.documentElement.classList.add('menu-open');
    document.body.classList.add('menu-open');
    toggle?.setAttribute('aria-expanded', 'true');
    panel.showModal();
  };
  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  panel?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeMenu();
  });
  panel?.addEventListener('close', () => { if (!panel.open) restorePage(); });
  desktop.addEventListener('change', () => { if (desktop.matches) closeMenu(); });
  addEventListener('pageshow', closeMenu);
  const updateHeader = () => header?.classList.toggle('is-scrolled', (locked ? scrollPosition : window.scrollY) > 24);
  updateHeader();
  addEventListener('scroll', updateHeader, { passive: true });
</script>
