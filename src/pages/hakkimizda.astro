---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ui/ContactCTA.astro';
import { site } from '../data/site';
---
<BaseLayout title="Hakkımızda | Durmuş Aydemir Group" description="Durmuş Aydemir Group, 1985’ten beri Antalya’da faaliyet gösteriyor.">
  <header class="about-hero"><div class="container-wide"><nav class="breadcrumbs" aria-label="Sayfa yolu"><a href="/">Ana Sayfa</a><span>/</span><span>Hakkımızda</span></nav><span class="eyebrow">1985’ten beri</span><h1>Durmuş Aydemir Group</h1></div></header>
  <section class="about-story"><div class="container about-story__grid"><div data-reveal><span class="eyebrow">Şirket</span><h2>Antalya merkezli bir grup şirketiyiz.</h2></div><div data-reveal><p class="lead">1985’te ticari hayatımıza başladık. 2008’den bu yana inşaat alanında da çalışıyoruz.</p><p>İnşaat, emlak, otomotiv ve hayvancılık alanlarında faaliyet gösteriyoruz. Konut ve iş yeri projelerimizi Antalya’nın farklı bölgelerinde hayata geçiriyoruz.</p><p>Proje geliştirme, uygulama, satış ve satış sonrası iletişimi kendi ekiplerimizle yürütüyoruz.</p></div></div></section>
  <section class="timeline"><div class="container-wide timeline__head"><span class="eyebrow">Tarihçe</span><h2>Önemli tarihler.</h2></div><div class="container-wide timeline__grid"><div><strong>{site.founded}</strong><p>Ticari faaliyete başlangıç</p></div><div><strong>{site.constructionSince}</strong><p>İnşaat yatırımlarına başlangıç</p></div><div><strong>{site.projectCount}</strong><p>İnşaat projesi</p></div><div><strong>Bugün</strong><p>Antalya’da devam eden projeler</p></div></div></section>
  <section class="mission"><div class="container-wide mission__grid"><article data-reveal><span class="eyebrow">Ne yapıyoruz</span><h2>Konut ve iş yeri projeleri geliştiriyoruz.</h2><p>Projelerde planlama, uygulama ve satış süreçlerini aynı ekip içinde takip ediyoruz.</p></article><article data-reveal><span class="eyebrow">Önceliğimiz</span><h2>Doğru bilgi ve düzenli iletişim.</h2><p>Proje, teslim ve satış süreçlerinde müşterilerle doğrudan iletişim kuruyoruz.</p></article></div></section>
  <ContactCTA />
</BaseLayout>
<style>
  .about-hero{padding:clamp(130px,17vw,250px) 0 clamp(80px,10vw,150px);color:#eee9de;background:var(--dark)}.about-hero .breadcrumbs{margin-bottom:90px;color:#aaa399}.about-hero h1{max-width:12ch;margin:22px 0 0;font:400 clamp(58px,8vw,120px)/.91 var(--serif);letter-spacing:-.06em}.about-story{padding:clamp(100px,13vw,190px) 0}.about-story__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:10vw}.about-story h2{max-width:11ch;margin:20px 0 0;font:400 clamp(43px,5vw,73px)/1 var(--serif)}.about-story .lead{margin:0 0 35px;font:400 clamp(25px,3vw,38px)/1.35 var(--serif)}.about-story p:not(.lead){color:var(--muted);font-size:17px}.timeline{padding:clamp(90px,11vw,150px) 0;background:#ddd5c8}.timeline__head h2{margin:15px 0 60px;font:400 clamp(44px,5.5vw,82px)/1 var(--serif)}.timeline__grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #a99f90}.timeline__grid>div{padding:32px 24px 0 0}.timeline strong{font:400 clamp(40px,4.5vw,65px)/1 var(--serif)}.timeline p{max-width:20ch;color:#625c53}.mission{padding:clamp(100px,13vw,190px) 0}.mission__grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border)}.mission article{padding:clamp(35px,5vw,70px);background:var(--background)}.mission h2{margin:55px 0 40px;font:400 clamp(34px,4vw,57px)/1.07 var(--serif)}.mission p{color:var(--muted)}@media(max-width:800px){.about-story__grid,.mission__grid{grid-template-columns:1fr}.timeline__grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.timeline__grid{grid-template-columns:1fr}}
</style>
