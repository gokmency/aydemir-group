---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ui/ContactCTA.astro';
import { services } from '../../data/services';
import type { Service } from '../../data/services';
export function getStaticPaths(){return services.map((service)=>({params:{slug:service.slug},props:{service}}));}
interface Props{service:Service} const{service}=Astro.props as Props;
---
<BaseLayout transparentHeader title={`${service.name} | Durmuş Aydemir Group`} description={service.description??`${service.name}, Durmuş Aydemir Group faaliyet alanı.`} image={service.image ?? '/images/projects/aydemir-cadde/cover.avif'} canonical={`/hizmetler/${service.slug}/`}>
  <header class="service-hero">{service.image?<img src={service.image} alt={`${service.name} faaliyet alanı`} width="1920" height="1080" fetchpriority="high"/>:<div class="empty-media">{service.name}</div>}<div class="service-hero__scrim"></div><div class="container-wide service-hero__content"><nav class="breadcrumbs" aria-label="Sayfa yolu"><a href="/">Ana Sayfa</a><span>/</span><a href="/hizmetler/">Hizmetler</a><span>/</span><span>{service.name}</span></nav><span class="eyebrow">Faaliyet alanı</span><h1>{service.name}</h1></div></header>
  <section class="service-detail"><div class="container service-detail__grid"><div data-reveal><span class="eyebrow">Durmuş Aydemir Group</span><h2>Bu alandaki çalışmalarımız.</h2></div><div data-reveal>{service.description?<p>{service.description}</p>:<p>Bu faaliyet alanına ilişkin ayrıntılı açıklama kaynak arşivde yer almıyor.</p>}<a class="text-link" href="/iletisim/">İletişime geçin ↗</a></div></div></section>
  <ContactCTA title={`${service.name} hakkında görüşelim.`}/>
</BaseLayout>
<style>
  .service-hero{position:relative;min-height:85svh;display:flex;align-items:end;overflow:hidden;color:#fff;background:var(--dark)}.service-hero>img,.service-hero>.empty-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.service-hero__scrim{position:absolute;inset:0;background:linear-gradient(0deg,rgba(20,19,16,.8),transparent 70%)}.service-hero__content{position:relative;z-index:2;padding-bottom:clamp(55px,8vw,110px)}.service-hero .breadcrumbs{margin-bottom:70px;color:#ddd7cc}.service-hero h1{margin:15px 0 0;font:400 clamp(70px,11vw,165px)/.82 var(--serif);letter-spacing:-.065em}.service-detail{padding:clamp(100px,13vw,190px) 0}.service-detail__grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:10vw}.service-detail h2{max-width:10ch;margin:18px 0 0;font:400 clamp(42px,5vw,72px)/1 var(--serif)}.service-detail p{margin:0 0 40px;font:400 clamp(23px,2.7vw,35px)/1.45 var(--serif)}@media(max-width:760px){.service-detail__grid{grid-template-columns:1fr}}
</style>
